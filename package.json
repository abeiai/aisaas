{
  "name": "aisaas",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm -r dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm --filter @aisaas/database build && pnpm -r typecheck",
    "test": "pnpm --filter @aisaas/database build && pnpm -r test",
    "db:generate": "pnpm --filter @aisaas/database db:generate",
    "db:migrate": "pnpm --filter @aisaas/database db:migrate",
    "db:migrate:deploy": "pnpm --filter @aisaas/database db:migrate:deploy",
    "db:seed": "pnpm --filter @aisaas/database db:seed",
    "seed:demo": "DATABASE_URL=\"${DATABASE_URL:-postgresql://aisaas:aisaas_dev_password@localhost:7344/aisaas?schema=public}\" pnpm --filter @aisaas/database seed:demo",
    "template:blank": "DATABASE_URL=\"${DATABASE_URL:-postgresql://aisaas:aisaas_dev_password@localhost:7344/aisaas?schema=public}\" pnpm --filter @aisaas/database template:blank",
    "ai:seed-tools": "pnpm --filter @aisaas/database ai:seed-tools",
    "ai:seed-presets": "pnpm --filter @aisaas/database ai:seed-presets",
    "release:check": "node scripts/release/check.mjs",
    "release:publish": "scripts/release/publish.sh",
    "release:deploy": "scripts/release/deploy.sh"
  }
}
