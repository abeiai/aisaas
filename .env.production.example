AI_PROVIDER_MAX_TOKENS="2048"

DASHSCOPE_API_KEY=""
AUDIO_UPLOAD_MAX_BYTES="20971520"
AUDIO_TTS_CREDITS_PER_100_CHARS="5"
AUDIO_TTS_MINIMUM_CREDITS="5"
AUDIO_VOICE_CLONE_CREDITS="300"
AUDIO_VOICE_DESIGN_CREDITS="200"
