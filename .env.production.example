# 复制为 .env.production 后再部署。不要提交真实生产密钥。

NODE_ENV="production"
APP_VERSION="0.0.0"

APP_BASE_URL="https://example.com"
API_BASE_URL="http://api-core:7342/api"
AI_GATEWAY_BASE_URL="http://ai-gateway:7343"
API_CORE_PORT="7342"
API_BODY_LIMIT="12mb"

NGINX_HTTP_PORT="7340"
NGINX_HTTPS_PORT="7346"

POSTGRES_USER="aisaas"
POSTGRES_PASSWORD="请替换为高强度数据库密码"
POSTGRES_DB="aisaas"
POSTGRES_BIND_HOST="127.0.0.1"
POSTGRES_HOST_PORT="7347"
DATABASE_URL="postgresql://aisaas:请替换为高强度数据库密码@postgres:7347/aisaas?schema=public"
REDIS_URL="redis://redis:7348"

JWT_ACCESS_SECRET="请替换为至少32位随机字符串"
JWT_REFRESH_SECRET="请替换为至少32位随机字符串"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
SECRET_ENCRYPTION_KEY="请替换为至少32位随机字符串"

RATE_LIMIT_WINDOW_SECONDS="60"
RATE_LIMIT_AUTH_LOGIN_MAX="10"
RATE_LIMIT_AUTH_REGISTER_MAX="5"
RATE_LIMIT_ADMIN_AUTH_LOGIN_MAX="10"
RATE_LIMIT_PAYMENT_ORDERS_MAX="20"
RATE_LIMIT_AI_TASKS_MAX="20"

LOGIN_FAILURE_MAX_ATTEMPTS="5"
LOGIN_FAILURE_WINDOW_SECONDS="900"
LOGIN_FAILURE_LOCK_SECONDS="900"

DEFAULT_ADMIN_EMAIL="admin@example.com"
DEFAULT_ADMIN_PASSWORD="请替换为高强度管理员初始密码"

PUBLIC_API_BASE_URL="https://example.com/api"
UPLOAD_DRIVER="local"
UPLOAD_DIR="/app/uploads"
MEDIA_UPLOAD_MAX_BYTES="209715200"
S3_ENDPOINT=""
S3_BUCKET=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""
S3_FORCE_PATH_STYLE="1"
S3_KEY_PREFIX="uploads/"
CMS_SCHEDULED_PUBLISHER_ENABLED="1"
CMS_SCHEDULED_PUBLISHER_INTERVAL_MS="60000"

ALIPAY_APP_ID=""
ALIPAY_ENV="production"
ALIPAY_GATEWAY_URL=""
ALIPAY_PRIVATE_KEY=""
ALIPAY_PUBLIC_KEY=""
ALIPAY_NOTIFY_URL="https://example.com/api/payment/alipay/notify"

WECHAT_PAY_MCH_ID=""
WECHAT_PAY_APP_ID=""
WECHAT_PAY_GATEWAY_URL=""
WECHAT_PAY_API_V3_KEY=""
WECHAT_PAY_PRIVATE_KEY=""
WECHAT_PAY_SERIAL_NO=""
WECHAT_PAY_PLATFORM_PUBLIC_KEY=""
WECHAT_PAY_PLATFORM_SERIAL_NO=""
WECHAT_PAY_NOTIFY_URL="https://example.com/api/payment/wechat/notify"

# 生产环境保持为空，只有演示/本地验收时才可设为 1。
ENABLE_MOCK_PAYMENT_NOTIFY=""

AI_GATEWAY_TIMEOUT_MS="120000"
AI_PROVIDER_NAME=""
AI_PROVIDER_BASE_URL=""
AI_PROVIDER_MODEL_DISPLAY_NAME=""
AI_PROVIDER_MODEL_NAME=""
AI_PROVIDER_API_KEY=""
AI_PROVIDER_INPUT_PRICE="1"
AI_PROVIDER_OUTPUT_PRICE="4"
